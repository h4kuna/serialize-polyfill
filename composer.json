{
  "name": "h4kuna/serialize-polyfill",
  "description": "Provide methods for serialization and use igbinary if is available.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Milan Matějček",
      "email": "milan.matejcek@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "nette/utils": ">= 3.0"
  },
  "require-dev": {
    "nette/tester": "^2.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "tracy/tracy": "^2.9"
  },
  "suggest": {
    "ext-igbinary": "to use efficient serialization"
  },
  "autoload": {
    "psr-4": {
      "h4kuna\\Serialize\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "h4kuna\\Serialize\\Tests\\": "tests/src"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "coverage": "vendor/bin/tester --coverage coverage.html --coverage-src src/ --colors 1 -s -C tests/src",
    "qa": [
      "@tests",
      "@stan"
    ],
    "stan": "vendor/bin/phpstan analyse",
    "tests": "vendor/bin/tester --colors 1 -s -C tests/src"
  }
}
